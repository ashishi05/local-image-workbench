# 可选：模型放在别的盘时使用。
# 把本文件改名为 extra_model_paths.yaml，放进 ComfyUI 根目录（与 main.py 同级）。
# base_path 改成你放模型的根目录；下面各行的相对路径会拼在它后面。
# 不放这个文件时，ComfyUI 使用自己 models 目录下的默认子文件夹。

my_models:
  base_path: D:/AI/models
  is_default: true
  checkpoints: checkpoints
  diffusion_models: diffusion_models
  text_encoders: text_encoders
  vae: vae
  loras: loras
